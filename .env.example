GEMINI_API_KEY=
GROQ_API_KEY=

AGENT_NAME=Mira
USER_NAME=bondhu

VOICE_BN=bn-BD-NabanitaNeural
VOICE_EN=en-US-AriaNeural

GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=gemma3:1b

# Voice: direct = Gemini ekbar e shune uttor dey (fast). separate = age lekha, tarpor uttor
VOICE_MODE=direct
# Kotha shesh hoyeche bujhte koto second chup thakbe (0.6 - 1.5)
SILENCE_SECONDS=0.9
# Separate mode e lekhar jonno: gemini (Bangla e bhalo) ba groq (Whisper)
STT=gemini

# Window app
WAKE_WORD=on
TRAY=on
WEB_PORT=8765

# Weather er shohor
CITY=Dhaka
